<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <RootNamespace>Plugin.Uno.MVVMExpress.Validation</RootNamespace>
    <AssemblyName>Plugin.Uno.MVVMExpress.Validation</AssemblyName>
    <PackageId>Plugin.Uno.MVVMExpress.Validation</PackageId>
    <PackageIcon>icon.png</PackageIcon>
    <Title>WPF MVVMExpress — DataAnnotations validation</Title>
    <Description>IValidator and DataAnnotationsValidator for Plugin.Uno.MVVMExpress. FluentValidation remains an optional app-level adapter.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plugin.Uno.MVVMExpress.Core\Plugin.Uno.MVVMExpress.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\nuget.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Plugin.Uno.MVVMExpress.Validation.Tests" />
  </ItemGroup>

</Project>
