<Project Sdk="Uno.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>App1</RootNamespace>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>App1</ApplicationTitle>
    <ApplicationId>dev.nuvyntra.uno.mvvmexpress.app1</ApplicationId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Plugin.Uno.MVVMExpress" Version="$(UnoMvvmExpressVersion)" />
    <PackageReference Include="Plugin.Uno.MVVMExpress.Dialogs" Version="$(UnoMvvmExpressVersion)" />
    <PackageReference Include="Plugin.Uno.MVVMExpress.Navigation" Version="$(UnoMvvmExpressVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\App1.Core\App1.Core.csproj" />
  </ItemGroup>

</Project>
